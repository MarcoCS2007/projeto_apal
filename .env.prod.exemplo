# ==========================================
# Configurações do Django (Produção)
# ==========================================
SECRET_KEY=U%*#()&@!&*(#&$*(!@Y#&(!@*#&(!@*#&(!@*#  # Chave real e forte
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=127.0.0.1,localhost,<seu_ip_privado>,<seu_dominio>,<seu_ip_publico> #Roda local e na rede

# ==========================================
# Banco de Dados (PostgreSQL Produção)
# ==========================================
POSTGRES_DB=apal_db_prod
POSTGRES_USER=apal_user_prod_super_seguro
POSTGRES_PASSWORD=senha_complexa_de_producao
POSTGRES_HOST=db  # Ou o IP do banco da AWS/DigitalOcean, se for separado
POSTGRES_PORT=5432